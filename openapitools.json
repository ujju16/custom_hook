{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.19.0",
    "generators": {
      "oanda-client": {
        "generatorName": "typescript-fetch",
        "inputSpec": "./oanda-openapi.json",
        "output": "./src/api/generated",
        "additionalProperties": {
          "supportsES6": true,
          "npmName": "@oanda/api-client",
          "npmVersion": "1.0.0",
          "withInterfaces": true,
          "useSingleRequestParameter": true
        },
        "globalProperty": {
          "models": "",
          "apis": ""
        }
      }
    }
  }
}
