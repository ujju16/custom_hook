{
  "name": "lab5_fetch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite build && vite preview --host",
    "generate:api": "openapi-generator-cli generate -i ./oanda-openapi.json -g typescript-fetch -o ./src/api/generated --skip-validate-spec --additional-properties=supportsES6=true,npmName=@oanda/api-client,npmVersion=1.0.0,withInterfaces=true,useSingleRequestParameter=true"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.2",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.28.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite": "^5.2.0"
  }
}
